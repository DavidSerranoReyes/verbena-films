# 🎬 VERBENA FILMS - EJEMPLO DE CONFIGURACIÓN
# Copia este archivo a .env y configura tus valores

# === STRAPI CONFIGURATION ===
PUBLIC_USE_STRAPI=false
PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here

# === SITE CONFIGURATION ===
PUBLIC_SITE_URL=https://verbenafilms.com

# ========================================
# 📊 ANALYTICS (opcional)
# ========================================

# Google Analytics ID
# PUBLIC_GA_ID=G-XXXXXXXXXX

# ========================================
# 📧 CONTACT (opcional)
# ========================================

# Email de contacto
# PUBLIC_CONTACT_EMAIL=contact@verbenafilms.com

# ========================================
# 🌐 SITE CONFIGURATION (opcional)
# ========================================

# URL del sitio en producción
# PUBLIC_SITE_URL=https://verbenafilms.com
